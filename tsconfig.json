{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@cobalt/ui": ["src/index.ts"],
      "@cobalt/ui/registry": ["src/registry.ts"],
      "@cobalt/ui/styles.css": ["src/styles/index.css"]
    }
  },
  "include": ["src", "site", "tests", "*.ts"]
}
